context time-routing {
    200 => {
        NoOp(--- Kontrola casu, fronty a schranky (AEL) ---);
        ifTime(08:00-16:00|mon-fri|*|*) {
            NoOp(--- OTEVRENO: Vstup do fronty ---);
            Queue(recepce_fronta,t,,,30);
            // Pokud fronta vyprší, skočíme automaticky dál do schránky
            goto closed;
        } else {
            catch closed {
                NoOp(--- ZAVRENO: Voicemail ---);
                Playback(tt-monkeys);
                VoiceMail(101@default,u);
                Hangup();
            }
        }
    }
}
