context time-routing {
    // Časově podmíněné směrování (Po-Pá 08:00-16:00) v AEL
    200 => {
        NoOp(--- Příchozí hovor: Kontrola pracovní doby (AEL) ---);
        ifTime(08:00-16:00|mon-fri|*|*) {
            NoOp(--- Stav: OTEVŘENO ---);
            Dial(PJSIP/101, 20);
            Hangup();
        } else {
            NoOp(--- Stav: ZAVŘENO ---);
            Playback(tt-monkeys);
            Hangup();
        }
    }
}
