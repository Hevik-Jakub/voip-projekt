context time-routing {
    // Časově podmíněné směrování v AEL (Po-Pá 08:00-16:00)
    200 => {
        NoOp(--- Příchozí hovor: Kontrola pracovní doby (AEL) ---);
        ifTime(08:00-16:00|mon-fri|*|*) {
            NoOp(--- Stav: OTEVŘENO ---);
            Dial(SIP/101, 20);
            VoiceMail(101@default, b);
            Hangup();
        } else {
            NoOp(--- Stav: ZAVŘENO ---);
            Playback(tt-monkeys);
            VoiceMail(101@default, u);
            Hangup();
        }
    }
}
